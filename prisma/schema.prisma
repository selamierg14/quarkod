// Müşteri Memnuniyet Anketi Sistemi — çoklu işletme veri modeli
// Şema tek bir ortak altyapıda birden fazla işletmeyi taşır: her anket kaydı
// businessId ile etiketlenir, kategoriler sabit kod değil veritabanındadır.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Kiracı: sistemi satın alan müşteri (bir kafe zinciri ya da tek işletme sahibi).
///
/// Her işletme ve her kullanıcı bir hesaba bağlıdır. Veri izolasyonunun tek
/// dayanağı budur — bir hesabın kullanıcısı hiçbir koşulda başka bir hesabın
/// verisini göremez.
model Account {
  id           String    @id @default(cuid())
  name         String
  /// Faturalama ve iletişim için hesap sahibinin adresi.
  email        String?
  /// Askıya alınan hesabın kullanıcıları panele giremez, QR'ları çalışmaz.
  active       Boolean   @default(true)
  /// "deneme" | "standart" — deneme hesapları self-servis kayıttan gelir.
  plan         String    @default("standart")
  /// Self-servis kayıtta isteğin geldiği IP'nin karması. Aynı IP'den seri
  /// deneme hesabı açılmasını sınırlamak için; ham IP saklanmıyor.
  signupIpHash String?
  /// Aboneliğin bittiği an. Null ise süresiz. Bu tarihten sonra hesap
  /// `active` alanına bakılmaksızın pasif sayılır: kullanıcılar panele
  /// giremez, QR'lar çalışmaz. Veri silinmez — ödeme gelince kaldığı
  /// yerden devam eder.
  expiresAt    DateTime?
  /// QR menü modülü. Ayrı satıldığı için hesap düzeyinde açılır; kapalıyken
  /// müşteri karşılama ekranını hiç görmez, doğrudan ankete gider.
  menuEnabled  Boolean   @default(false)
  /// İYS'de hizmet sağlayıcı kodu. Ticari ileti izinleri bu kodun altındaki
  /// markalara bildirilir.
  iysCode      String?

  /// Self-servis kayıtta KVKK aydınlatma metninin onaylandığı an ve sürümü.
  /// Onay kutusu işaretleniyordu ama kanıtı saklanmıyordu; "hangi metne,
  /// ne zaman rıza verildi" sorusu sonradan cevaplanabilsin diye tutuluyor.
  kvkkOnayAt DateTime?
  kvkkSurum  String?

  createdAt DateTime @default(now())

  businesses Business[]
  users      User[]
  payments   Payment[]

  @@map("accounts")
}

/// Bir hesaba işlenen abonelik ödemesi.
///
/// Ödeme akışı manuel: müşteri IBAN'a havale yapar, platform yöneticisi bunu
/// panele kaydeder ve isterse aynı işlemde aboneliği uzatır. Amaç "kim, ne
/// zaman, ne kadar ödedi ve süre ne kadar uzadı" sorusunun izini tutmak —
/// aksi hâlde tek dayanak yöneticinin hafızası ve banka ekstresi oluyordu.
model Payment {
  id          String    @id @default(cuid())
  accountId   String
  /// Kuruş cinsinden ödenen tutar (₺1.290,00 → 129000). Para her zaman tam
  /// sayı kuruş olarak tutulur; kayan nokta yuvarlama hatası olmasın.
  amountKurus Int
  /// "IBAN havale — Ağustos" gibi serbest açıklama.
  note        String?
  /// Bu ödemeyle aboneliğin uzatıldığı yeni bitiş tarihi (uzatma yapıldıysa).
  extendedTo  DateTime?
  /// Kaydı giren platform yöneticisinin adı — denetim izinden ayrı, listede
  /// hızlı görünsün diye burada da tutuluyor.
  recordedBy  String
  createdAt   DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("payments")
}

/// İşletme türü. Kategori şablonlarının varsayılanını ve QR tasarımını belirler.
/// SQLite enum desteklemediği için string olarak tutulur: "yeme_icme" | "balikci" | "gece_kulubu"
model Business {
  id              String  @id @default(cuid())
  /// Hangi kiracıya ait. Göç sırasında doldurulduktan sonra zorunlu hale geldi.
  accountId       String
  /// Genel adres (/f/{slug}/{masa}) kısa kalsın diye sistem genelinde tekil;
  /// çakışma olursa işletme açılışında sonek eklenir.
  slug            String  @unique
  name            String
  type            String
  address         String?
  googleReviewUrl String?

  /// Bu puanın altındaki (<=) geri bildirimler anlık bildirim tetikler.
  notifyThreshold Int     @default(3)
  /// 5 yıldız verildiğinde Google'a yönlendirilsin mi. Kapatılırsa herkese
  /// nötr teşekkür ekranı gösterilir (review-gating'den çıkış yolu).
  googleRedirect  Boolean @default(true)
  /// QR baskılarında kullanılan marka rengi (hex).
  brandColor      String  @default("#111827")
  /// Basılan QR kartında QR'ın üstünde duran çağrı metni. Okutulma oranını
  /// en çok etkileyen şey bu cümle olduğu için işletmeye göre düzenlenebilir.
  qrCardText      String?
  /// İYS'de bu işletmenin marka kodu.
  iysBrandCode    String?
  /// Anket ekranında gösterilen logo (yuvarlak marka rozeti). Data URI olarak
  /// saklanır: dış depolama servisi gerektirmez, her ortamda çalışır. Yükleme
  /// tarayıcıda küçültüldüğü için birkaç KB'de kalır.
  logoUrl         String?
  /// Anket ekranının tepesindeki kapak fotoğrafı (kafenin görseli). Aynı
  /// gerekçeyle data URI; tarayıcıda ~1200px genişliğe küçültülür.
  coverUrl        String?

  /// QR karşılama ekranında ikon olarak gösterilir.
  instagramUrl       String?
  /// QR menünün tepesinde görünen duyuru şeridi ("Hafta sonu canlı müzik").
  /// Metin dolu kalsa da şerit ayrı bir anahtarla kapatılabilir: kampanya
  /// bittiğinde metni silmek yerine kapatıp sonra geri açmak isteniyor.
  announcement       String?
  announcementActive Boolean @default(false)
  /// QR karşılama ekranındaki Wi-Fi butonu için. İkisi de doluysa buton
  /// SSID + şifreyi kopyalanabilir şekilde gösterir.
  wifiSsid           String?
  wifiPassword       String?

  /// Online sipariş platformlarının işletmeye özel sayfa linkleri. Dolu
  /// olanlar QR karşılama ekranında platform butonu olarak görünür; müşteri
  /// masada değilse (paket/eve sipariş) doğrudan oraya yönlenir.
  yemeksepetiUrl String?
  getirUrl       String?
  trendyolUrl    String?
  migrosUrl      String?

  /// Menü fiyatlarının en son güncellendiği an. Ürün eklendiğinde ya da
  /// fiyatı değiştiğinde otomatik güncellenir; menüde "fiyatlar şu tarihte
  /// güncellendi" olarak gösterilir (fiyat şeffaflığı / yönetmelik).
  menuPriceUpdatedAt DateTime?

  /// Vardiya planlaması ve otomatik etiketleme için: hangi vardiyalar
  /// kullanılıyor ve saat kaçta başlıyor. Sabit üçlü (sabah/akşam/gece) her
  /// işletmeye uymuyor — gece çalışmayan bir kafe ya da öğle vardiyası olan
  /// bir yer bunu kendine göre ayarlar. Bitiş saati tutulmaz: bir sonraki
  /// aktif vardiyanın başlangıcı örtük bitiştir.
  vardiyaSabahAktif Boolean @default(true)
  vardiyaSabahSaat  String  @default("06:00")
  vardiyaOgleAktif  Boolean @default(false)
  vardiyaOgleSaat   String  @default("12:00")
  vardiyaAksamAktif Boolean @default(true)
  vardiyaAksamSaat  String  @default("16:00")
  vardiyaGeceAktif  Boolean @default(true)
  vardiyaGeceSaat   String  @default("23:00")

  createdAt DateTime @default(now())

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categories           CategoryTemplate[]
  tables               Table[]
  feedbacks            Feedback[]
  users                User[]
  coupons              Coupon[]
  surveyViews          SurveyView[]
  consents             MarketingConsent[]
  menuCategories       MenuCategory[]
  menuItems            MenuItem[]
  itemRatings          ItemRating[]
  bolgeMudurleri       UserBusiness[]
  shiftAssignments     ShiftAssignment[]
  shiftNotes           ShiftNote[]
  leaveRequests        LeaveRequest[]
  checklistItems       ChecklistItem[]
  checklistCompletions ChecklistCompletion[]
  duyurular            Duyuru[]

  @@index([accountId])
  @@map("businesses")
}

/// Karşılama ekranında ayrı, tıklanması gereken bir kart olarak çıkan
/// etkinlik/kampanya duyurusu. Menünün tepesindeki tek satırlık `announcement`
/// şeridinden farkı: birden fazla olabilir, görsel taşıyabilir, tarih
/// aralığına bağlanabilir (ör. "sadece hafta sonu göster").
model Duyuru {
  id         String    @id @default(cuid())
  businessId String
  baslik     String
  aciklama   String?
  imageUrl   String?
  /// Boşsa hemen başlar / hiç bitmez.
  baslangic  DateTime?
  bitis      DateTime?
  aktif      Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, aktif])
  @@map("duyurular")
}

/// Bir personelin belirli bir güne ve vardiyaya atanması.
///
/// Vardiya etiketi geri bildirimde zaten tutuluyordu ama "o vardiyada kim
/// çalışıyordu" hiçbir yerde yoktu — bu ikisi birleşmeden "akşam vardiyasında
/// puanlar neden düşük" sorusu cevaplanamıyordu.
model ShiftAssignment {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  /// Saat kısmı önemsiz; sadece gün. Yerel saatle 00:00'a sabitlenir.
  date       DateTime
  /// "sabah" | "aksam" | "gece" — SHIFTS ile aynı sözlük.
  shift      String
  createdAt  DateTime @default(now())

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  swapRequests ShiftSwapRequest[]

  @@unique([businessId, userId, date, shift])
  @@index([businessId, date])
  @@index([userId, date])
  @@map("shift_assignments")
}

/// Bir personelin kendi vardiyasını bırakma talebi. Onay/red yöneticide;
/// onaylanırsa atama kaldırılır, kim başka biri koyacaksa çizelgeden ayrıca
/// atanır — talep otomatik yer değiştirme yapmaz, yalnızca boşaltır.
model ShiftSwapRequest {
  id            String    @id @default(cuid())
  assignmentId  String
  requestedById String
  note          String?
  /// "bekliyor" | "onaylandi" | "reddedildi"
  status        String    @default("bekliyor")
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  assignment  ShiftAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  requestedBy User            @relation("ShiftSwapRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?           @relation("ShiftSwapDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([assignmentId])
  @@index([requestedById])
  @@index([decidedById])
  @@map("shift_swap_requests")
}

/// Personel izni ve müsaitliği.
///
/// Çizelgeyi kuran kişi kimin ne zaman yok olduğunu bilmeden plan yapıyordu;
/// bilgi WhatsApp'ta ya da sözlü kalıyor, izinli birine vardiya yazıldığında
/// hiçbir şey uyarmıyordu. Kaydın kaynağı iki yerden gelir ve ikisi de aynı
/// tabloda birikir: personel kendi ekranından talep açar (status "bekliyor",
/// yönetici onaylar — ShiftSwapRequest ile birebir aynı akış), ya da yönetici
/// doğrudan girer (o zaman kayıt zaten onaylı doğar). Böylece "izinli olduğu
/// ne belli" sorusunun cevabı hep bir kayıt: kim istedi, kim onayladı, ne zaman.
///
/// Not: paneldeki "İzinler" ekranı ticari ileti onaylarını (MarketingConsent)
/// gösteriyor; bu tamamen ayrı bir kavram, o yüzden bu modül vardiya
/// planlamasının altında "İzin & müsaitlik" adıyla duruyor.
model LeaveRequest {
  id         String @id @default(cuid())
  businessId String
  userId     String

  /// Gün bazlı ve kapsayıcı aralık: tek günlük izinde baslangic = bitis.
  /// Saat tutulmaz — çizelge zaten gün+vardiya çözünürlüğünde.
  baslangic DateTime
  bitis     DateTime

  /// "yillik" | "rapor" | "ucretsiz" | "musait_degil"
  /// Ayrım rapor için önemli: yıllık izin planlanır, rapor sonradan girilir,
  /// "müsait değil" ise resmi bir izin değil (ör. okul günü).
  tur       String  @default("yillik")
  aciklama  String?

  /// "bekliyor" | "onaylandi" | "reddedildi"
  status      String    @default("bekliyor")
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user      User     @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  /// Çizelge her açılışta "bu hafta kim izinli" diye aralık sorgusu atıyor.
  @@index([businessId, baslangic, bitis])
  @@index([userId])
  @@index([decidedById])
  @@map("leave_requests")
}

/// Vardiya devir notu: "masa 5'te sorun oldu, dikkat" gibi bir sonraki
/// vardiyaya bırakılan kısa not.
model ShiftNote {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime
  shift      String
  authorId   String
  text       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
  @@index([authorId])
  @@map("shift_notes")
}

/// Açılış/kapanış görev şablonu — işletme bazında tanımlanır, her gün aynı
/// liste tekrar sorulur.
model ChecklistItem {
  id         String  @id @default(cuid())
  businessId String
  label      String
  /// "acilis" | "kapanis"
  gorev      String
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  completions ChecklistCompletion[]

  @@index([businessId, gorev, sortOrder])
  @@map("checklist_items")
}

/// Bir görevin belirli bir günde tamamlandığı kayıt. Aynı gün aynı görev
/// yalnızca bir kez işaretlenir — kim, ne zaman tamamladı burada durur.
model ChecklistCompletion {
  id            String   @id @default(cuid())
  itemId        String
  businessId    String
  date          DateTime
  completedById String
  completedAt   DateTime @default(now())

  item        ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  completedBy User          @relation(fields: [completedById], references: [id], onDelete: Cascade)

  @@unique([itemId, date])
  @@index([businessId, date])
  @@index([completedById])
  @@map("checklist_completions")
}

/// Her işletmenin anket kategorileri. Admin panelinden düzenlenebilir.
/// Kim ne yaptı — çok kiracılı üründe hesap verebilirliğin kaydı.
///
/// Aktör adı ve rolü o anki haliyle kopyalanır: kullanıcı sonradan silinse
/// ya da rolü değişse bile kaydın anlamı bozulmasın.
model AuditLog {
  id        String   @id @default(cuid())
  /// Etkilenen kiracı. Platform işlemlerinde null olabilir.
  accountId String?
  actorId   String?
  actorName String
  actorRole String
  /// "feedback.status" | "menu.item.create" | "account.enter" gibi.
  action    String
  /// İnsan tarafından okunabilir özet: "Masa 12 · yeni → çözüldü".
  detail    String?
  entity    String?
  entityId  String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Zamanlanmış işlerin çalışma kaydı.
///
/// KVKK temizliği ya da yedekleme cron'a bağlanmayı unutulduğunda sessizce
/// hiç çalışmıyordu; bu tablo "en son ne zaman çalıştı" sorusunu panelden
/// cevaplanabilir hale getiriyor.
model JobRun {
  id         String    @id @default(cuid())
  /// "kvkk-temizle" | "yedekle" | "haftalik-rapor"
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  detail     String?

  @@index([name, startedAt])
  @@map("job_runs")
}

model CategoryTemplate {
  id             String  @id @default(cuid())
  businessId     String
  name           String
  sortOrder      Int     @default(0)
  active         Boolean @default(true)
  /// Düşük puan verildiğinde açılan "hangi alanda?" seçenekleri, virgülle
  /// ayrılmış. Boşsa kategori adına göre akıllı varsayılan kullanılır
  /// (bkz. src/lib/anket-detay.ts) — işletme hiç ayar yapmadan da çalışsın.
  problemOptions String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@map("category_templates")
}

model Table {
  id          String    @id @default(cuid())
  businessId  String
  tableNumber String
  /// QR linkindeki token. Masa bazlı, tahmin edilemez.
  qrToken     String    @unique
  /// Anti-spam (P1) için: token bu tarihten sonra geçersiz sayılabilir.
  qrExpiresAt DateTime?
  /// Sahne Marin gibi masa kavramı olmayan yerlerde tek ortak giriş QR'ı.
  isEntrance  Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  feedbacks   Feedback[]
  surveyViews SurveyView[]

  @@unique([businessId, tableNumber])
  @@index([businessId])
  @@map("tables")
}

model Feedback {
  id            String  @id @default(cuid())
  businessId    String
  tableId       String?
  overallRating Int

  /// { "kategori adı": 1-5 } — kategoriler işletmeye göre değiştiği için JSON.
  categoryRatings String?
  /// { "kategori adı": ["Tuvaletler", "Masalar"] } — düşük puan verilen
  /// kategoride müşterinin işaretlediği sorun alanları. Şikayeti "mekan
  /// pisti"ten "tuvaletler pisti"ne indirdiği için ayrı tutuluyor.
  problemDetails  String?
  comment         String?
  /// Yorumun aramaya hazır kopyası: küçük harf + Türkçe aksanlar sadeleştirilmiş.
  /// SQLite'ın LIKE'ı ş/ğ/ı gibi harflerde büyük-küçük eşleştirmediği için gerekli.
  commentSearch   String?
  photoUrl        String?
  contactInfo     String?
  /// "telefon" | "eposta" — hangi kanaldan dönüleceği.
  contactType     String?
  /// KVKK açık rızası; iletişim bilgisi ancak rıza ile saklanır.
  consentGiven    Boolean   @default(false)
  consentAt       DateTime?
  /// Rıza alınırken gösterilen aydınlatma metninin sürümü.
  consentVersion  String?
  /// İletişim bilgisinin saklama süresi dolduğunda silindiği an.
  contactErasedAt DateTime?

  /// Şikayet döngüsünün kapandığı iz: işletmenin müşteriye panelden gönderdiği
  /// yanıtın anı, metni ve kanalı. Müşteri KVKK rızasıyla "yalnızca bu geri
  /// bildirim hakkında bana dönülsün" dediği için bu iletişim rızanın tam
  /// kapsamında; yine de yanıt yalnızca rıza + iletişim bilgisi varken açılır.
  respondedAt     DateTime?
  responseText    String?
  /// "telefon" | "eposta" — yanıtın hangi kanaldan gittiği.
  responseChannel String?

  /// "yeni" | "incelendi" | "cozuldu"
  status          String    @default("yeni")
  internalNote    String?
  /// Durumun en son değiştiği an.
  statusChangedAt DateTime?
  /// "cozuldu" durumuna ilk geçiş anı — yanıt süresi bundan hesaplanır.
  resolvedAt      DateTime?

  /// 5 yıldızda Google butonu gösterildi mi.
  redirectedToGoogle Boolean   @default(false)
  /// Müşteri o butona gerçekten tıkladı mı — asıl dönüşüm ölçüsü budur.
  googleClickedAt    DateTime?
  /// Vardiya etiketi (P1): "sabah" | "aksam" | "gece"
  shift              String?

  ipHash    String?
  /// Tarayıcı başına rastgele kimlik (çerez). Kafe Wi-Fi'ında herkes aynı IP'yi
  /// paylaştığı için tekrar kontrolünün asıl dayanağı budur.
  visitorId String?
  createdAt DateTime @default(now())

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table         Table?             @relation(fields: [tableId], references: [id], onDelete: SetNull)
  coupons       Coupon[]
  notifications Notification[]
  consents      MarketingConsent[]
  itemRatings   ItemRating[]

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([visitorId, tableId, createdAt])
  @@index([ipHash, businessId, createdAt])
  /// Masa kırılımı ve masa silme bu sütundan geçiyor; en hızlı büyüyen
  /// tablo burası olduğu için indeks bugünden duruyor.
  @@index([tableId])
  @@map("feedbacks")
}

/// QR menüdeki bölüm: "Kahveler", "Tatlılar", "Ana Yemekler"...
///
/// Anket kategorilerinden (CategoryTemplate) ayrı bir şey: o "servis hızı"
/// gibi ölçütleri tutar, bu ise satılan ürünleri gruplar.
model MenuCategory {
  id         String  @id @default(cuid())
  businessId String
  name       String
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  createdAt DateTime @default(now())

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    MenuItem[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id         String @id @default(cuid())
  /// Kategoriyle birlikte işletme de tutuluyor: ürün raporları ve izolasyon
  /// sorguları kategoriye join atmadan çalışsın diye.
  businessId String
  categoryId String

  name        String
  description String?
  /// Fiyat kuruş cinsinden tam sayı. Ondalıklı sayıda 19.90 gibi değerler
  /// yuvarlama hatası biriktirir; menüde 1 kuruş sapma bile güven kaybıdır.
  priceKurus  Int?
  /// Ürün fotoğrafı, data URI. Tarayıcıda küçültülür (logo/kapak ile aynı yol).
  imageUrl    String?

  /// Bugün tükendi mi. Menünün en sık değişen alanı bu; ürünü silmek yerine
  /// işaretlenir, çünkü yarın geri gelecek ve geçmiş puanları ona bağlı.
  soldOut Boolean @default(false)
  /// Diyet/alerjen etiketleri, virgülle ayrılmış: "vegan,glutensiz,aci".
  /// Sabit bir listeden seçildiği için ayrı tablo kurmaya değmiyor.
  tags    String?

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ratings  ItemRating[]

  @@index([businessId, active])
  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

/// Müşterinin tek bir ürüne verdiği puan.
///
/// Genel puandan ayrı tutuluyor: "servis yavaştı ama tatlı harikaydı"
/// diyebilmek, işletmenin sorunu nerede arayacağını bilmesi demek.
model ItemRating {
  id         String  @id @default(cuid())
  feedbackId String
  businessId String
  menuItemId String?

  rating   Int
  /// Puanlandığı andaki ürün adı. Ürün sonradan silinse ya da adı değişse
  /// eski raporlar anlamsızlaşmasın diye kayda kopyalanıyor; menuItemId
  /// silinmede null'a düşer, isim kalır.
  itemName String

  createdAt DateTime @default(now())

  feedback Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  /// Aynı ankette aynı ürün iki kez puanlanmasın.
  @@unique([feedbackId, menuItemId])
  @@index([businessId, createdAt])
  @@index([menuItemId])
  @@map("item_ratings")
}

model User {
  id           String  @id @default(cuid())
  /// Platform yöneticisi (superadmin) hiçbir hesaba ait değildir.
  accountId    String?
  name         String
  /// Girişte kullanılan ad. E-posta değil bu sorulur — personel değişiminde
  /// e-posta değişse de giriş bilgisi sabit kalsın diye.
  username     String  @unique
  /// Bildirim ve iletişim için; giriş kimliği değil.
  email        String  @unique
  /// 2FA kodunun gideceği numara (+905XXXXXXXXX). Yoksa 2FA uygulanamaz.
  phone        String?
  passwordHash String
  /// "superadmin" (platformu işleten biz — tüm hesaplar)
  /// "owner"      (hesabın sahibi — kendi hesabındaki tüm işletmeler)
  /// "bolge"      (bölge müdürü — kendisine atanmış birden çok işletme)
  /// "manager"    (yalnızca kendi işletmesi)
  /// "garson"     (saha personeli — yalnızca kendi vardiyasını ve görevlerini
  ///               görür; rapor/ayar ekranlarına hiç girmez)
  role         String
  /// Yalnızca "manager"/"garson" için tek işletme. Bölge müdürünün
  /// işletmeleri UserBusiness tablosunda; owner/superadmin için null.
  businessId   String?
  active       Boolean @default(true)

  /// Kullanıcının açık modülleri: "anket" | "menu" | "iys" | "pazarlama" |
  /// "personel" (bkz. src/lib/moduller.ts).
  ///
  /// Devretme kuralı: bir kullanıcı yalnızca KENDİ sahip olduğu modülleri
  /// altındakine verebilir. Zinciri platform yöneticisi başlatır — hesap
  /// sahibine ne verirse, sahip ekibine en fazla onu dağıtabilir. Böylece
  /// "müşteri kendi kendine satın almadığı modülü açamaz" kuralı tek bir
  /// yerde, veriyle korunuyor.
  ///
  /// Platform yöneticisi (superadmin) bu listeye bakılmaksızın hepsine
  /// erişir; onun için satırın içeriği anlamsızdır.
  moduller String[] @default([])

  /// KULLANIM DIŞI — yerini `moduller` aldı (bkz. yukarısı). Sütunlar,
  /// içerdikleri veri silinmesin diye bırakıldı; hiçbir kod okumuyor.
  /// Bir sonraki temizlik turunda düşürülebilir.
  menuIzni  Boolean @default(true)
  anketIzni Boolean @default(true)

  /// Şifrenin en son ne zaman değiştiği. Bu andan ÖNCE üretilmiş oturum
  /// jetonları geçersiz sayılır: şifresi çalınan kullanıcı şifresini
  /// değiştirdiğinde saldırganın açık oturumu da kapansın diye.
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())

  account              Account?              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  business             Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)
  otpCodes             OtpCode[]
  businesses           UserBusiness[]
  shiftAssignments     ShiftAssignment[]
  shiftNotes           ShiftNote[]
  checklistCompletions ChecklistCompletion[]
  shiftSwapRequests    ShiftSwapRequest[]    @relation("ShiftSwapRequester")
  shiftSwapDecisions   ShiftSwapRequest[]    @relation("ShiftSwapDecider")
  leaveRequests        LeaveRequest[]        @relation("LeaveRequester")
  leaveDecisions       LeaveRequest[]        @relation("LeaveDecider")
  pushSubscriptions    PushSubscription[]

  @@index([accountId])
  /// notifyLowRating her eşik altı puanda "bu işletmenin sorumlusu kim"
  /// diye buraya soruyor.
  @@index([businessId])
  @@map("users")
}

/// Bölge müdürünün sorumlu olduğu işletmeler.
///
/// Ayrı tablo şart: tek `businessId` alanı bir kullanıcıya yalnızca bir
/// işletme bağlayabiliyor, zincirde "üç şubeye bakan müdür" temsil
/// edilemiyordu.
model UserBusiness {
  userId     String
  businessId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
  @@map("user_businesses")
}

/// Tek kullanımlık SMS kodu (giriş 2. adımı ve şifre sıfırlama).
///
/// Kod düz metin saklanmaz — şifre gibi hash'lenir. Veritabanını gören biri
/// aktif kodları okuyup başkasının hesabına giremesin diye.
model OtpCode {
  id       String @id @default(cuid())
  userId   String
  /// "giris" | "sifre"
  purpose  String
  codeHash String

  /// Yanlış deneme sayısı; eşiği aşınca kod yakılır.
  attempts  Int       @default(0)
  expiresAt DateTime
  /// Kullanıldığı an; dolu ise kod bir daha geçerli değildir.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("otp_codes")
}

model Coupon {
  id         String    @id @default(cuid())
  businessId String
  feedbackId String?
  code       String    @unique
  discount   String
  used       Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  feedback Feedback? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([feedbackId])
  @@map("coupons")
}

/// QR okutup anket ekranını açanlar. Gönderilenlerle oranlanınca tamamlama
/// oranı çıkar: "kaç kişi okuttu, kaçı bitirdi".
model SurveyView {
  id         String   @id @default(cuid())
  businessId String
  tableId    String?
  visitorId  String?
  /// Müşteri en az bir yıldıza dokundu mu — anketin geri kalanı (kategori,
  /// ürün, yorum) bu andan sonra açılıyor. Sayfayı görüp hiç dokunmadan
  /// çıkanla, yıldız verip formu terk edeni ayırt etmek için: ilki "ilgi
  /// çekmedi", ikincisi "anket çok uzun/rahatsız edici" demek — ikisinin
  /// çözümü farklı.
  yildizVerildi Boolean @default(false)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table    Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([visitorId, tableId, createdAt])
  @@index([tableId])
  @@map("survey_views")
}

/// Admin giriş denemeleri — kaba kuvvet saldırısını yavaşlatmak için.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipHash    String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

/// Ticari elektronik ileti izni (İYS kaydı).
///
/// KVKK açık rızasından TAMAMEN AYRIDIR: o rıza yalnızca ilgili geri bildirime
/// dönüş içindir ve 90 günde silinir. Bu kayıt ise ayrı bir kutuyla, ayrı bir
/// metinle alınır, 6563 sayılı kanun gereği İYS'ye bildirilir ve izin geri
/// alınana kadar saklanır — silinmesi değil, RET'e çevrilmesi gerekir.
///
/// Alan adları bilerek İYS API'sinin sözlüğünü izler (recipient / type /
/// recipientType / status / source / consentDate), böylece dışa aktarımda
/// çeviri hatası olmaz.
model MarketingConsent {
  id         String  @id @default(cuid())
  businessId String
  /// İzin hangi ankette alındı — kanıt zinciri için.
  feedbackId String?

  /// İYS "recipient": +905XXXXXXXXX veya e-posta.
  recipient     String
  /// İYS "type": ARAMA | MESAJ | EPOSTA
  channel       String
  /// İYS "recipientType": BIREYSEL | TACIR
  recipientType String   @default("BIREYSEL")
  /// İYS "status": ONAY | RET
  status        String   @default("ONAY")
  /// İYS "source": izin nereden alındı (HS_WEB, HS_MOBIL...).
  source        String   @default("HS_WEB")
  /// İYS "consentDate" — izin/ret anı.
  consentAt     DateTime
  /// Onaylanan metnin sürümü.
  textVersion   String
  /// Onay anında ekranda gösterilen metnin tam kopyası. Sürüm numarası tek
  /// başına yetmez: metin aynı sürümle değiştirilirse hangi cümlenin
  /// onaylandığı kanıtlanamaz. Uyuşmazlıkta dayanağımız bu alandır.
  consentText   String?
  /// 6563 sayılı kanun elektronik ortamda alınan onayın IP kaydını ister; bu
  /// yüzden burada özet değil gerçek adres saklanır. Yalnızca ticari ileti
  /// izninin ispatı amacıyla tutulur.
  ipAddress     String?
  ipHash        String?

  /// İYS'ye bildirildiği an. Null ise bildirim bekliyor.
  reportedAt       DateTime?
  /// İYS'nin döndürdüğü işlem kimliği.
  iysTransactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  feedback Feedback? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  /// İYS aynı alıcı+tip+alıcı tipi için en güncel kaydı esas alır; biz de tek
  /// satır tutup durumu güncelliyoruz.
  @@unique([businessId, channel, recipient])
  @@index([businessId, reportedAt])
  @@index([feedbackId])
  @@map("marketing_consents")
}

model Notification {
  id         String    @id @default(cuid())
  feedbackId String
  /// "email" | "whatsapp" | "telegram" | "push"
  channel    String
  recipient  String
  sentAt     DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  /// Bu tablonun hiç indeksi yoktu. İki sorgu buradan geçiyor: geri bildirim
  /// detayında o kaydın bildirimleri, ve "gönderilemeyen var mı" sağlık
  /// sorgusu. İkincisi sentAt'i boş olanları tarıyor; kısmi indeks yalnızca
  /// sorunlu satırları tuttuğu için başarılı gönderimler onu şişirmiyor.
  @@index([feedbackId])
  @@index([createdAt])
  @@map("notifications")
}

/// Push bildirim aboneliği — bir kullanıcının bir cihazına bildirim
/// gönderebilmek için tarayıcıdan alınan uç nokta ve şifreleme anahtarları.
///
/// iOS'ta Web Push yalnızca site "Ana Ekrana Ekle" ile eklenmiş şekilde
/// çalışıyor (bkz. profil sayfasındaki uyarı); bu tablo o kısıtı bilmiyor,
/// sadece hangi tarayıcının hangi anahtarla dinlediğini tutuyor. Aynı
/// kullanıcının birden fazla cihazı (telefon + masaüstü) olabileceği için
/// userId değil endpoint tekil — bir cihaz çıkarsa yalnızca o satır silinir.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Abonelik neden kapandı: kullanıcı "Kapat" dedi, çıkış yaptı ya da
  /// push servisi cihazın artık var olmadığını bildirdi (404/410).
  /// Satır silinmiyor: "bildirim gelmiyor" şikayetinde aboneliğin hiç
  /// açılmadığı mı yoksa cihazın mı düştüğü ancak bu izle ayırt edilebilir.
  disabledAt     DateTime?
  disabledReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Gönderim tarafı hep "bu kullanıcının AÇIK abonelikleri" diye soruyor;
  /// kapatılmış satırlar zamanla birikeceği için indeks ikisini birlikte tutuyor.
  @@index([userId, disabledAt])
  @@map("push_subscriptions")
}
