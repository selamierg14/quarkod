# Mobil uygulamanın derleme zamanı değişkenleri.
# `EXPO_PUBLIC_` önekli her değer PAKETİN İÇİNE gömülür ve uygulamayı
# indiren herkes okuyabilir — buraya gizli bir şey yazmayın.

# Backend adresi. Boş bırakılırsa geliştirmede Expo'nun bildiği LAN
# adresine (http://<ip>:3000) düşülür. YAYINDA https olmak ZORUNDA:
# app.config.ts, APP_ORTAMI=yayin iken http adresle derlemeyi durduruyor.
EXPO_PUBLIC_API_URL=""

# Evrensel bağlantıların alan adı (https:// olmadan): "quarkod.app".
# Boşsa associatedDomains/intentFilters hiç eklenmez ve mekan linkleri
# uygulamada değil tarayıcıda açılır.
EXPO_PUBLIC_SITE_DOMAIN=""

# EAS profili ayarlıyor: gelistirme | onizleme | yayin (bkz. eas.json).
APP_ORTAMI="gelistirme"
