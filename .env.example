# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
#   cp .env.example .env
# Gerçek .env sürüm kontrolüne girmez (.gitignore'da).

# Veritabanı (Postgres). Yerel geliştirmede `docker compose up -d` ile
# başlattığınız Postgres'i hedefler (aşağıdaki değer onunla eşleşir).
# Preprod/prod'da gerçek sunucunun bağlantı dizesiyle değiştirin — kod hiç
# değişmez.
DATABASE_URL="postgresql://cafe:cafe_local_dev_sifre@localhost:5433/cafe_projesi"

# ÜRETİMDE (Neon/Vercel): DATABASE_URL connection POOLER adresi olmalı —
# uç nokta adında "-pooler" geçer:
#   postgresql://...@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Serverless'te her fonksiyon örneği kendi bağlantısını açar; doğrudan uç
# noktaya bağlanmak trafik artınca "too many connections" ile sonuçlanır.
#
# DIRECT_URL ise HAVUZSUZ (pooler'sız) adres ve yalnızca migration'lar için
# kullanılır: PgBouncer işlem kipinde çalıştığı için migration'ların
# ihtiyaç duyduğu oturum düzeyi komutlarını desteklemez.
# Yerel geliştirmede ikisi de aynı olabilir; boş bırakılırsa DATABASE_URL kullanılır.
DIRECT_URL=""

# Uygulama örneği başına Postgres havuz boyutu. Varsayılan 5; pooler
# kullanıldığında asıl çoğullama PgBouncer'da olduğu için küçük tutulur.
DB_HAVUZ_BOYUTU=""

# Admin oturum çerezini imzalayan anahtar. En az 32 karakter, rastgele olmalı.
# Üretme: openssl rand -base64 36
# Bu değeri bilen biri istediği kullanıcı adına oturum jetonu üretebilir.
AUTH_SECRET=""

# Anket linklerinde ve QR kodlarında kullanılan taban adres. QR'lar basılmadan
# önce gerçek alan adı olmalı; sonradan değiştirmek basılı kartları çöpe atar.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# E-posta bildirimi (SMTP). Boş bırakılırsa bildirimler konsola yazılır ve
# veritabanına "gönderilmedi" olarak işlenir — sistem çalışmaya devam eder.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS sağlayıcısı (ekomesaj) — 2FA kodları ve şifre sıfırlama buradan geçer.
#
# SMS_SENDER, sağlayıcıda KAYITLI GÖNDERİCİ BAŞLIĞI ("başlık") — API
# kullanıcı adı DEĞİL. İkisi karıştırıldığında sağlayıcı mesajı reddediyor
# ve hata ancak SMS gelmeyince fark ediliyor.
#
# UYARI: sağlayıcının verdiği uç http:// ile başlıyor. Basic auth kimlik
# bilgilerini düz metin taşır; araya girebilen biri kullanıcı adı ve
# şifreyi okuyabilir. Sağlayıcı https sunuyorsa onu tercih edin.
SMS_API_URL="http://panel4.ekomesaj.com:9587/sms/create"
SMS_API_USER=""
SMS_API_PASS=""
SMS_SENDER=""

# SMS ile iki adımlı giriş. "true" dışındaki her değer kapalı sayılır.
# Kapalıyken şifresi doğru olan kullanıcı doğrudan panele girer.
# (Panelden şifre değiştirmek bu bayraktan bağımsız olarak hep kod ister.)
# Girişte iki aşamalı doğrulama. Açmadan ÖNCE çalıştırın:
#   npm run 2fa:hazirlik
# Kodu gönderilemeyen her hesap giriş yapamaz hâle gelir; betik kimlerin
# etkileneceğini önceden söyler.
TWO_FACTOR_ENABLED="false"

# YALNIZCA TEST İÇİN. Doluyken TÜM doğrulama kodları bu numaraya gider ve
# kullanıcıların kendi numarası yok sayılır. Canlıda mutlaka boş olmalı;
# üretimde dolu bırakılırsa sunucu açılmaz.
# Doluyken HERKESİN kodu bu numaraya gider — yalnızca test için.
# ÜRETİMDE MUTLAKA BOŞ: dolu bırakılırsa iki aşamalı doğrulama anlamını
# yitirir, çünkü kod kullanıcının kendi telefonuna hiç gitmez.
SMS_TEST_PHONE=""

# Vercel Cron'un zamanlanmış işleri (bkz. vercel.json, /api/cron/*)
# tetikleyebilmesi için. Vercel proje ayarlarına bu değeri Environment
# Variable olarak eklerseniz, Vercel kendi cron isteklerine otomatik olarak
# "Authorization: Bearer $CRON_SECRET" başlığını ekler. Boş bırakılırsa
# uç tamamen kapalı kalır (iş hiç çalışmaz) — açık bırakılmış bir "veriyi
# sil" ucundan iyidir.
# Üretme: openssl rand -hex 32
CRON_SECRET=""

# --- Push bildirimleri (isteğe bağlı) -----------------------------------------
# Düşük puan geldiğinde panel açık olmasa bile işletme sahibinin/sorumlusunun
# telefonuna anlık bildirim düşürmek için (Web Push standardı). İkisi de
# boşsa özellik sessizce kapalı kalır — abone olma butonu görünmez.
#
# Üretme: npx web-push generate-vapid-keys
#
# Public key tarayıcıya gönderildiği için NEXT_PUBLIC_ önekiyle; private
# key yalnızca sunucuda kalır, asla client'a gitmez.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Push servislerinin (Apple/Google) sorun durumunda bize ulaşabilmesi için
# zorunlu bir iletişim adresi — bir e-posta ya da site adresi olabilir.
VAPID_SUBJECT="mailto:destek@quarkod.app"

# --- Pazarlama sitesi (hepsi isteğe bağlı) -----------------------------------

# Sticky çağrı çubuğundaki ve altbilgideki telefon. Boş bırakılırsa arama
# düğmesi hiç basılmaz — çalışmayan bir numara göstermektense.
NEXT_PUBLIC_ILETISIM_TEL=""

# Gizlilik sayfasındaki başvuru adresi ve altbilgi.
NEXT_PUBLIC_ILETISIM_EPOSTA=""

# Google Search Console doğrulama kodu (HTML etiketi yöntemi). Search
# Console > Mülk ekle > HTML etiketi adımında verilen content değeri.
# Boşsa doğrulama etiketi hiç basılmaz.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# HTTPS zorlaması. SSL sertifikası TAKILDIKTAN SONRA "1" yapın:
#   - düz HTTP istekleri 308 ile HTTPS'e taşınır,
#   - Strict-Transport-Security başlığı gönderilir.
# Sertifika yokken açmak siteyi erişilemez kılar; varsayılan kapalı.
HTTPS_ZORUNLU=""

# Tohumlanan yönetici hesabının cep numarası (npm run db:seed).
# İki aşamalı doğrulama açıkken giriş kodu buraya gider — kendi numaranızı
# yazmazsanız varsayılan kimseye ait olmayan bir numaradır ve o hesaba
# giriş yapılamaz.
SEED_ADMIN_PHONE=""
